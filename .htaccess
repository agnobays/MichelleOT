# ----------------------------------------------------------------------
# Michelle OT - Apache / cPanel Web Server Configuration
# ----------------------------------------------------------------------

# 1. Custom 404 Error Page
ErrorDocument 404 /404.html

# 2. Rewrite Engine & Force HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect HTTP to HTTPS (excluding ACME challenge for Let's Encrypt)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 3. Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. MIME Types (ensures SVG favicon displays properly)
<IfModule mod_mime.c>
  AddType image/svg+xml .svg .svgz
</IfModule>

# 5. Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript image/svg+xml
</IfModule>

# 6. Disable Browser Caching for CSS and HTML during development / updates
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm|css|js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
</IfModule>
